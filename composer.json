{
  "name": "laravel-chronicle/anchor-s3",
  "description": "S3 Object Lock (WORM) anchoring adapter for the Chronicle audit ledger.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "chronicle",
    "audit",
    "anchoring",
    "s3",
    "object-lock",
    "worm",
    "aws"
  ],
  "homepage": "https://github.com/laravel-chronicle/anchor-s3",
  "support": {
    "email": "support@laravel-chronicle.dev",
    "issues": "https://github.com/laravel-chronicle/anchor-s3/issues",
    "docs": "https://laravel-chronicle.dev"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ntoufoudis"
    }
  ],
  "authors": [
    {
      "name": "Vasileios Ntoufoudis",
      "email": "info@ntoufoudis.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel-chronicle/core": "^1.11",
    "aws/aws-sdk-php": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.14",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^3.0||^4.0",
    "pestphp/pest-plugin-laravel": "^3.0||^4.0"
  },
  "autoload": {
    "psr-4": {
      "Chronicle\\AnchorS3\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Chronicle\\AnchorS3\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Chronicle\\AnchorS3\\AnchorS3ServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": "vendor/bin/pint",
    "test:lint": "vendor/bin/pint --test -v",
    "test:types": "vendor/bin/phpstan analyse",
    "test:unit": "vendor/bin/pest --exclude-group=localstack --exclude-group=aws",
    "test:localstack": "vendor/bin/pest --group=localstack",
    "test:aws": "vendor/bin/pest --group=aws",
    "test:all": "vendor/bin/pest",
    "test": [
      "@test:lint",
      "@test:types",
      "@test:unit"
    ]
  }
}
